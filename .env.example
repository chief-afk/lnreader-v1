# Tracker API client ids (optional). Copy this file to `.env` before building
# to enable tracker login; the app builds and works without it (AniList
# Discover browsing and MyAnimeList Discover need no credentials).
# Values are baked in at build time via react-native-dotenv, so changing them
# requires a rebuild.

# Register an app at https://anilist.co/settings/developer and set its
# redirect URL to lnreaderv1://
ANILIST_CLIENT_ID=

# Register an API client at https://myanimelist.net/panel/apiclient
# (redirect URL lnreaderv1://; the app uses the PKCE flow, so no secret is sent)
MYANIMELIST_CLIENT_ID=
